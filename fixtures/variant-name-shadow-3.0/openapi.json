{
  "openapi": "3.0.3",
  "info": {
    "title": "variant name shadow",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "post": {
        "operationId": "createPet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PetRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Envelope" }
              }
            }
          }
        }
      }
    },
    "/pets/form": {
      "post": {
        "operationId": "submitPetForm",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Pet" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PetRequest" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "name": { "type": "string" }
        }
      },
      "PetRequest": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" }
        }
      },
      "Envelope": {
        "type": "object",
        "properties": {
          "pet": { "$ref": "#/components/schemas/Pet" }
        }
      }
    }
  }
}
