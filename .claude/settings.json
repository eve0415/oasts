{
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/gate.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "allow": [
      "Bash(cargo fmt --check *)",
      "Bash(cargo fmt --check)",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo doc *)",
      "Bash(cargo --version)",
      "Bash(cargo bench *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec oxlint *)",
      "Bash(pnpm exec oxfmt *)",
      "Bash(rustup show *)",
      "Bash(rustup show)",
      "Bash(rustup check *)",
      "Bash(rustup check)",
      "Bash(rustc --version)"
    ]
  }
}
