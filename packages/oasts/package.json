{
  "name": "@oasts/cli",
  "version": "0.0.4",
  "description": "OpenAPI-to-TypeScript compiler with fully typed errors, compile-time auth checks, and a zero-dependency fetch client — plus first-party Zod, TanStack Query, and MSW artifacts.",
  "keywords": [
    "api-client",
    "codegen",
    "compiler",
    "fetch",
    "msw",
    "napi-rs",
    "openapi",
    "openapi3",
    "rust",
    "swagger",
    "tanstack-query",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/eve0415/oasts#readme",
  "bugs": "https://github.com/eve0415/oasts/issues",
  "license": "MIT",
  "author": "eve0415",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eve0415/oasts.git",
    "directory": "packages/oasts"
  },
  "bin": {
    "oasts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.node"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:napi": "napi build --platform --release --esm --manifest-path ../../crates/oasts-napi/Cargo.toml -o napi",
    "test:e2e": "pnpm build && node --test test-e2e/cli.e2e.test.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "@types/node": "26.4.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "msw": "^2.8.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "napi": {
    "binaryName": "oasts",
    "npmClient": "pnpm",
    "packageName": "@oasts/binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
