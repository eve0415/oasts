{
  "name": "oasts",
  "version": "0.0.0",
  "description": "Types-only OpenAPI to TypeScript generator",
  "bin": {
    "oasts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.node"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:napi": "napi build --platform --release --esm --manifest-path ../../crates/oasts-napi/Cargo.toml -o napi",
    "test:e2e": "pnpm build && node --test test-e2e/cli.e2e.test.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.1",
    "@types/node": "26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "msw": "^2.8.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
