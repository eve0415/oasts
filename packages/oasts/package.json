{
  "name": "oasts",
  "version": "0.0.0",
  "description": "Types-only OpenAPI to TypeScript generator",
  "bin": {
    "oasts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.node"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:napi": "napi build --platform --release --esm --manifest-path ../../crates/oasts-napi/Cargo.toml -o napi",
    "test:e2e": "pnpm build && node --test test-e2e/cli.e2e.test.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@types/node": "24.13.3",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "tsdown": "0.22.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
