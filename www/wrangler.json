{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "PLAYGROUND_WASM",
      "bucket_name": "oasts-playground"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
