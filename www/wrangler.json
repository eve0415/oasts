{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "oasts",
  "compatibility_date": "2026-08-18",

  "placement": {
    "mode": "smart"
  },
  "preview_urls": true,
  "upload_source_maps": true,

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },

  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "run_worker_first": ["/playground/wasm/*"]
  },

  "r2_buckets": [
    {
      "binding": "PLAYGROUND_WASM",
      "bucket_name": "oasts-playground"
    }
  ]
}
