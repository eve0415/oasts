{
	"name": "oasts-www",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"//typescript": "typescript is pinned to 6.0.3 here, one major behind the workspace root's 7.0.2, because @astrojs/check (via @volar/kit) only resolves 6.0.3 today — `pnpm -C www why typescript` confirms it's the only version reachable in this workspace's graph. Bump once @astrojs/check supports TypeScript 7.x.",
	"scripts": {
		"dev": "wrangler types && astro dev",
		"build": "wrangler types && astro build",
		"preview": "astro preview",
		"typecheck": "wrangler types && astro check",
		"lint:docs": "nimbus-docs lint",
		"lint:docs:fix": "nimbus-docs lint --fix",
		"prepreview:cf": "astro build",
		"preview:cf": "wrangler dev -c dist/server/wrangler.json",
		"predeploy": "astro check && astro build",
		"deploy": "wrangler deploy -c dist/server/wrangler.json"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.2.5",
