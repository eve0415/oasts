		"@codemirror/state": "6.7.1",
		"@codemirror/view": "6.43.9",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@iconify-json/ph": "1.2.2",
		"@lezer/highlight": "1.2.3",
