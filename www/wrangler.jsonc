{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasts-docs",
  "compatibility_date": "2026-08-15",
  // The adapter derives the deploy config (entry point, ASSETS binding) into
  // dist/server/wrangler.json at build time; `main` here would be validated before it exists.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  // Historical compiler builds. The version shipped with this deploy is a static asset, so it
  // is served without ever reaching the Worker; only older versions fall through to R2.
  "r2_buckets": [
    {
      "binding": "PLAYGROUND_WASM",
      "bucket_name": "oasts-playground"
    }
  ]
}
