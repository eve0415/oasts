{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasts-docs",
  "compatibility_date": "2026-08-15",
  // The adapter derives the deploy config (entry point, ASSETS binding) into
  // dist/server/wrangler.json at build time; `main` here would be validated before it exists.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  }
}
